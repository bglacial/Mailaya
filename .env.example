# Identifiants OAuth 2.0 de type Application Web créés dans Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# auto : MLX sur Apple Silicon, Julia/PyTorch ailleurs (uv sync --extra julia).
# julia : impose Julia, y compris sur Mac. demo : aucun modèle à télécharger.
LAYA_BACKEND=auto

# Julia : modèle Hugging Face ou chemin d'un checkpoint local complet.
JULIA_MODEL=SupersonicLabs/Julia-1
JULIA_REVISION=a85b127321d580d65176c89ced8273f305745d85
JULIA_DEVICE=cpu
# Nombre de threads CPU, lu par Julia au démarrage (4 par défaut).
JULIA_CPU_THREADS=4

# LAYA MLX (Apple Silicon uniquement).
LAYA_MODEL=aac6fef/laya-multilingual-mlx
LAYA_DTYPE=float16

# Limites de sécurité pour une exécution locale.
MAX_EMAILS_PER_RUN=500
HOST=127.0.0.1
PORT=8000
