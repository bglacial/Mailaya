# auto : Julia/PyTorch. laya : LAYA/PyTorch. demo : moteur déterministe pour les tests.
# Le sélecteur web choisit toujours le vrai modèle pour chaque nouvelle analyse.
LAYA_BACKEND=auto

# Checkpoints et CPU pour les commandes locales et le moteur par défaut.
# Le sélecteur web utilise les deux checkpoints officiels indiqués dans l’interface.
LAYA_MODEL=convaiinnovations/laya-multilingual
LAYA_DEVICE=cpu
JULIA_MODEL=SupersonicLabs/Julia-1
JULIA_REVISION=a85b127321d580d65176c89ced8273f305745d85
JULIA_DEVICE=cpu
JULIA_CPU_THREADS=4

# Cookies sécurisés à activer derrière un reverse proxy HTTPS.
MAILAYA_SECURE_COOKIES=false
MAX_EMAILS_PER_RUN=500
HOST=127.0.0.1
PORT=8000
